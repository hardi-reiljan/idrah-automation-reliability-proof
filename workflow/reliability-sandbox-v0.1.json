      "parameters": {
        "jsCode": "const state = $getWorkflowStaticData('global');\nstate.seen = state.seen || {};\nstate.seen[$json.event_id] = new Date().toISOString();\nconst keys = Object.keys(state.seen);\nif (keys.length > 1000) {\n  keys.sort((a, b) => String(state.seen[a]).localeCompare(String(state.seen[b])));\n  for (const key of keys.slice(0, keys.length - 1000)) delete state.seen[key];\n}\nreturn [{ json: $json }];"
      },
