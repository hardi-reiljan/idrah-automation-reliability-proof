        "jsCode": "const payload = $json.body ?? $json;\nconst eventId = String(payload.event_id ?? '').trim();\nconst customerId = String(payload.customer_id ?? '').trim();\nconst action = String(payload.action ?? '').trim().toLowerCase();\nconst allowedActions = new Set(['classify', 'sync', 'notify']);\nconst reasons = [];\nif (!eventId) reasons.push('missing_event_id');\nif (!customerId) reasons.push('missing_customer_id');\nif (!allowedActions.has(action)) reasons.push('unsupported_action');\nconst state = $getWorkflowStaticData('global');\nstate.seen = state.seen || {};\nconst duplicate = Boolean(eventId && state.seen[eventId]);\nreturn [{ json: {\n  event_id: eventId || null,\n  customer_id: customerId || null,\n  action: action || null,\n  simulate_failure: payload.simulate_failure === true,\n  needs_review: reasons.length > 0,\n  review_reason: reasons.join(','),\n  duplicate\n} }];"
      },
